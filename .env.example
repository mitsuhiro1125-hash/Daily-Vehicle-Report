# ローカル開発用（このファイルはそのまま使えます。変更不要です）
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# 以下は「クラウド公開（Vercel）」のときだけ使う環境変数です。
# ローカルで動かすだけなら、下の項目は無視して大丈夫です。
# Vercelの管理画面（Project Settings → Environment Variables）で設定してください。
# ------------------------------------------------------------------

# Vercelの「Storage」から Prisma Postgres を接続すると自動で設定されます（手入力は不要）
# DATABASE_URL="..."

# アプリを開くときに入力してもらう合言葉（好きな文字列でOK。8文字以上推奨）
# APP_PASSWORD="任意のパスワード"

# 初期データ投入APIを保護するための合言葉（好きな文字列でOK。人に推測されにくいものを）
# SEED_SECRET="任意のランダムな文字列"

# 車両管理（登録・編集・削除）専用の管理者パスワード
# 未設定の場合は既定値「mIck3216」が使われます。変更したい場合のみ設定してください。
# ADMIN_PASSWORD="任意のパスワード"
