// 車両月報アプリ データベーススキーマ（ローカル開発用）
// SQLite + Prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 車両マスタ
model Vehicle {
  id        Int      @id @default(autoincrement())
  name      String // 車両名（例：営業車1号）
  number    String // 車両番号（ナンバープレート等）
  sortOrder Int      @default(0) // 表示順
  isActive  Boolean  @default(true) // 使用中／使用停止
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs VehicleLog[]

  @@map("vehicles")
}

// 車両利用記録（日報 / 月報の元データ）
model VehicleLog {
  id          Int      @id @default(autoincrement())
  date        DateTime // 利用日
  vehicleId   Int
  // 訪問先は複数件を改行区切りの文字列として保存する（初期版はシンプルさを優先）
  destination String
  endMeter    Float // 終業時メーター（km）
  fuelLocation String? // 給油場所（任意）
  fuelAmount   Float?  // 給油量（任意・リットル）
  note        String? // 備考（任意）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_logs")
}
